# Copy to app/.env and adjust. Never commit app/.env.
# All variable names are read by config/settings.py (pydantic-settings, case-insensitive).

# --- Step 1: codebooks -------------------------------------------------------
# Directory holding the four xlsx codebooks (another source can replace the xlsx later).
# Relative paths resolve against the app/ directory, not the current working directory.
CODEBOOK_DIR=data/codebooks
CODEBOOK_CTS_BA0036_FILE=CTS_BA0036_NEW.xlsx
CODEBOOK_BA0036_VALID_FILE=BA0036_2024_jen_validni.xlsx
CODEBOOK_CTS_OKEC_NACE2_FILE=CTS_OKEC_NACE2.xlsx
CODEBOOK_NACE_STAT_FILE=NACE_STAT.xlsx
# Optional human-readable label appended to the computed content-hash version, e.g. "2024-valid".
CODEBOOK_VERSION_LABEL=

# Where the codebooks come from: dir (CODEBOOK_DIR above, the local default) or blob (a private
# Vercel Blob store - the Vercel setting, roadmap E1/D3). With blob the four files are downloaded
# once per instance into CODEBOOK_DOWNLOAD_DIR (empty = the system temp dir, /tmp on Vercel).
CODEBOOK_SOURCE=dir
# Read-write token of the store; it can also delete the store, so on Vercel it is a Sensitive
# variable for Production and Preview only. Locally keep it in app/.env.local, never in git.
BLOB_READ_WRITE_TOKEN=
# Optional: the store id is otherwise taken from the token (vercel_blob_rw_<storeId>_<secret>).
BLOB_STORE_ID=
CODEBOOK_BLOB_PREFIX=codebooks/
CODEBOOK_BLOB_TIMEOUT_SECONDS=10
CODEBOOK_BLOB_MAX_ATTEMPTS=2
CODEBOOK_DOWNLOAD_DIR=

LOG_LEVEL=INFO
# The /probe diagnostics page (one fixed request per register, nothing secret shown).
PROBE_ENABLED=true

# --- The central database (roadmap D4) ---------------------------------------
# One Postgres for what a serverless function cannot keep on disk: the usage ledger (so the
# daily budget works in production), the answer cache (shared by every instance), the audit
# events and the error reports - from every device and every user. On Vercel: Storage ->
# Create Database -> Neon (Postgres) -> connect to the project; that sets DATABASE_URL.
# Empty = local files as before. Never commit a real URL: it carries the password.
DATABASE_URL=

# --- Error reports -----------------------------------------------------------
# The "Nahlásit k prověření" button stores the request, the result row and MO's note (core/reports.py).
# auto = db with DATABASE_URL, else dir;  db = the central database above;
# dir = one JSON file per report under REPORTS_DIR (a laptop, Docker with a volume);
# blob = the private Vercel Blob store above, under REPORTS_BLOB_PREFIX (the Vercel setting:
#        /tmp does not outlive the instance, so 'dir' there loses every report);
# off = no button.
REPORTS_SOURCE=auto
REPORTS_DIR=data/reports
REPORTS_BLOB_PREFIX=reports/
REPORTS_MAX_NOTE_CHARS=500

# --- Audit -------------------------------------------------------------------
# Requesting user written to the lookup audit log. Empty = the OS login name.
# NOTE: in a server the OS account is the SERVICE account, so for the web app the real user
# comes from a header set by the reverse proxy / SSO in front of it. That proxy MUST strip
# any client-supplied copy of the header - anything a browser can set is not an identity.
WEB_USER_HEADER=X-Remote-User
LOOKUP_USER=

# --- Sign-in -----------------------------------------------------------------
# The hash of the one password everybody signs in with, from
#   python -m core.classify --hash-password
# Never the password itself. Set = every page but /login, /health and /api/version needs
# that password and a name; the name (not WEB_USER_HEADER) is the user audited and charged
# for model calls. Changing it signs everybody out. Empty = the app is open, as before.
# In a .env file wrap the value in single quotes: the hash contains '$'.
#   APP_PASSWORD_HASH='pbkdf2_sha256$600000$...$...'
APP_PASSWORD_HASH=
# Signs the sign-in cookie. Required with APP_PASSWORD_HASH (without it nobody can sign in);
# changing it signs everybody out. On Vercel: a Sensitive variable.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# How long a sign-in lasts, in hours.
SESSION_HOURS=12
# The developers' page /admin (every model call with its cost, and MO's complaints): its own
# password, hashed the same way, on top of the MO sign-in when that is on. Empty = no page,
# no link. Needs SESSION_SECRET.
ADMIN_PASSWORD_HASH=

# --- Step 6: web evidence for foreign issuers --------------------------------
# Foreign issuers only. apl.czso.cz and or.justice.cz are refused in code and cannot be
# enabled here.
WEB_ENABLED=true
# Leave WEB_SEARCH_URL empty to work only from descriptions typed by the user.
# {query} is replaced with the url-encoded search text.
# WEB_SEARCH_URL=https://api.search.brave.com/res/v1/web/search?q={query}
# WEB_SEARCH_API_KEY=
# TODO: confirm these four against the approved provider (defaults follow Brave).
WEB_SEARCH_API_KEY_HEADER=X-Subscription-Token
WEB_SEARCH_RESULTS_PATH=web.results
WEB_SEARCH_FIELD_URL=url
WEB_SEARCH_FIELD_TITLE=title
WEB_SEARCH_FIELD_SNIPPET=description
WEB_MAX_RESULTS=4
WEB_MAX_PAGES=2
WEB_TIMEOUT_SECONDS=15
WEB_MIN_INTERVAL_SECONDS=0.5
WEB_MAX_DESCRIPTION_CHARS=1200
# With no typed description, an issuer whose ISIN gave a LEI is described from its Wikidata
# item (found by the LEI, never by name) and that item's Wikipedia article. Free, keyless.
# Hosts: www.wikidata.org, cs.wikipedia.org, en.wikipedia.org. Tried before WEB_SEARCH_URL.
WIKIMEDIA_ENABLED=true
# With no item for the LEI (or no LEI), take the one item whose label or alias exactly equals the
# official name and that carries no other entity's LEI; flagged "podle shody názvu" for review.
WIKIMEDIA_NAME_MATCH=true
WIKIPEDIA_LANGUAGES=cs,en
WIKIMEDIA_TIMEOUT_SECONDS=5
WIKIMEDIA_MIN_INTERVAL_SECONDS=0.3
WIKIMEDIA_MAX_ATTEMPTS=2

# --- Tool 1: issuer identification by ISIN (GLEIF, OpenFIGI) -------------------
# Public registers, keyless, no client data. GLEIF maps the ISIN to the issuer's LEI record
# (legal name, country, legal form, entity category, direct/ultimate parent); OpenFIGI
# describes the instrument (market name, security type, market sector). Hosts to allow on
# the egress side: api.gleif.org, api.openfigi.com.
GLEIF_ENABLED=true
GLEIF_BASE_URL=https://api.gleif.org/api/v1
GLEIF_TIMEOUT_SECONDS=15
# Published limit 60 requests/minute -> at least 1 s between requests.
GLEIF_MIN_INTERVAL_SECONDS=1.0
GLEIF_MAX_ATTEMPTS=3
# Also read the direct and ultimate parent: two more requests per issuer, worth it because
# who owns the issuer is the ESA control axis.
GLEIF_FETCH_PARENTS=true
OPENFIGI_ENABLED=true
OPENFIGI_BASE_URL=https://api.openfigi.com/v3
# Optional free key (openfigi.com/api): raises the limit from 25 to 250 requests/minute.
# OPENFIGI_API_KEY=
OPENFIGI_TIMEOUT_SECONDS=15
# Keyless limit read live 2026-09-22: ratelimit-policy 25;w=60 -> 2.5 s; with a key 0.25.
OPENFIGI_MIN_INTERVAL_SECONDS=2.5
OPENFIGI_MAX_ATTEMPTS=3

# --- Step 6: LLM classifier for foreign issuers ------------------------------
# Only the public issuer name, the web-derived description and codebook labels are ever
# sent. Nothing from DWS may reach a model.
# Put the real key here, never in code or in a chat. This file's .env copy is git-ignored.
# CURRENT STATE: no key is set, so the tool runs DETERMINISTICALLY - it narrows the
# codebooks to ~12 candidates each, with their CTS IDs, proposes a code where a rule
# decided, and a human confirms. That is a usable mode, not a broken one. Setting
# LLM_API_KEY turns on the model's choice with reasons. Which endpoint needs what:
# app/README.md -> "Enabling the model".
LLM_ENABLED=true
LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
# OpenAI's current cost-sensitive model (checked 23 Sept 2026); measure with
# `python -m core.classify --golden --model` before changing.
LLM_MODEL=gpt-5.6-luna
# Sent as reasoning_effort. "none" keeps temperature allowed on a reasoning model; any other
# value drops temperature. Empty = not sent (gpt-4o-mini and most gateways).
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0
# A lookup makes TWO model calls (one per codebook) and both must finish inside
# LOOKUP_DEADLINE_SECONDS (50 s, set by Vercel's 60 s maxDuration). One call's worst case is
# attempts x (connect + timeout) + backoff, so 15 s / 1 attempt = 20 s and two of them plus
# ~5 s of registers end at 45 s. RAISING THESE DOES NOT BUY PATIENCE, IT DISABLES THE MODEL:
# 60 s / 3 attempts is a 201 s worst case, no call is ever started, and every lookup abstains
# with "no time left for the model". Startup warns when the numbers cannot fit.
LLM_TIMEOUT_SECONDS=15
LLM_MAX_ATTEMPTS=1
LLM_MAX_SUGGESTIONS=3
# Empty disables the cache. Answers are keyed by issuer + description + codebook version
# + model + prompt version.
LLM_CACHE_PATH=data/cache/classifications.sqlite3

# --- spending limits (enforced in core/classify/budget.py) -------------------
# Set a cap in the OpenAI dashboard TOO - that is the backstop. These stop the call
# before it is made and turn an exhausted budget into "no suggestion, here is why".
# 0 switches an individual limit off.
LLM_MAX_PROMPT_TOKENS=8000
LLM_MAX_CALLS_PER_RUN=200
# ~3,400 tokens per uncached issuer, so 500k is roughly 140 issuers a day.
LLM_DAILY_TOKEN_BUDGET=500000
LLM_MAX_OUTPUT_TOKENS=700
# The usage ledger. NOTE: the daily budget cannot be enforced without it, so if this is
# empty while LLM_DAILY_TOKEN_BUDGET is set, every call is refused (fail closed).
LLM_USAGE_PATH=data/cache/llm_usage.sqlite3
